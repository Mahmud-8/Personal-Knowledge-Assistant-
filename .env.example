# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is listed in .gitignore.
# Variables that are commented out are optional; the value shown is the
# default used by config.py when the variable is not set.

# ----------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------

# App authentication (JWT). Use a long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL. The database is created on startup if it does not exist.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_POOL_SIZE=5

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Directory where ChromaDB stores embeddings (data/ is git-ignored).
VECTOR_STORE_DIR=data/chroma

# Google OAuth client (Web application) for Gmail.
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI"
# registered on the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# HuggingFace Hub. The embedding model (all-mpnet-base-v2) is downloaded on
# first start, so keep HF_HUB_OFFLINE=0 until it is cached. config.py
# defaults to 1 (offline) when this is not set.
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_XET=1

# ----------------------------------------------------------------------
# OPTIONAL — Gmail push notifications / auto-responder (Cloud Pub/Sub)
# Leave unset to disable. See README "Gmail Push Notifications".
# ----------------------------------------------------------------------

# GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/gmail-notifications
# GMAIL_PUBSUB_AUDIENCE=https://YOUR_PUBLIC_HOST/api/v1/gmail/push
# GMAIL_PUBSUB_SERVICE_ACCOUNT=gmail-push-invoker@PROJECT_ID.iam.gserviceaccount.com
# GMAIL_PUBSUB_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/gmail-push
# Optional shared secret; append ?token=<value> to the push endpoint URL.
# GMAIL_PUBSUB_VERIFICATION_TOKEN=
# GMAIL_WATCH_LABEL_IDS=INBOX
# GMAIL_WATCH_RENEW_INTERVAL_SECONDS=21600
# GMAIL_WATCH_RENEW_BEFORE_SECONDS=86400
# GMAIL_REPLY_LOCK_TIMEOUT_SECONDS=900
# GMAIL_REPLY_MAX_ATTEMPTS=3

# ----------------------------------------------------------------------
# OPTIONAL — other integrations
# ----------------------------------------------------------------------

# Slack
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:5000/slack/oauth/callback
# SLACK_BOT_TOKEN=

# Discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:5000/discord/callback
# DISCORD_BOT_TOKEN=

# Telegram (https://my.telegram.org)
# TELEGRAM_API_ID=0
# TELEGRAM_API_HASH=
